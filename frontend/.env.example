# 백엔드 오리진. 경로 접두 /api/v1 은 코드(apiContract.ts)가 붙이므로 여기 적지 않는다.
# 비워 두면 같은 오리진으로 나가 vite 프록시(/api -> 아래 주소)를 탄다.
VITE_API_BASE_URL=http://localhost:8080

# MSW 목 서버 사용 여부. false 로 두면 실제 백엔드로 요청이 나간다.
VITE_ENABLE_MSW=true

# 카카오 로그인 (개발자 콘솔에서 발급 — 티켓 1-1 선행).
# client_id 자리에는 REST API 키를 넣는다. JavaScript 키가 아니다.
# 비워 두면 로그인 버튼이 비활성 상태로 뜬다.
VITE_KAKAO_REST_API_KEY=

# 카카오 콘솔에 등록한 redirect URI 와 문자 단위로 같아야 한다.
# 비워 두면 현재 오리진 + /oauth/kakao 를 쓴다.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao
